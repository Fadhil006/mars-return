# Export REGION_DATA_DIR in the process environment to override the terrain path.
# This file is documentation; the service does not automatically load .env files.
# Optional assistant model for POST /api/brief. Leave MODEL_API_KEY empty to use the labelled template answers.
# Model mode also needs `pip install anthropic`; MODEL_PROVIDER must be empty or anthropic; MODEL_NAME defaults to claude-opus-5-5.
# Never put provider credentials in frontend/VITE_ variables.
MODEL_PROVIDER=
MODEL_API_KEY=
MODEL_NAME=
REGION_DATA_DIR=data/region
